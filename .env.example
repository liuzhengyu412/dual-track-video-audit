# 当前仓库内置 dashscope 适配器。其他服务需要新增 provider 适配器。
MODEL_PROVIDER=dashscope

# 三个模型角色可分别使用独立密钥。不要给变量值加引号；绝不要提交 .env。
ASR_API_KEY=
VISION_API_KEY=
TEXT_API_KEY=

# 三个模型角色的名称；请填写当前已接入模型服务可用的模型名。
ASR_MODEL=fun-asr-realtime
VISION_MODEL=qwen3-vl-32b-instruct
TEXT_MODEL=qwen3-32b

# 模型服务 API 地址与网络策略；一般无需修改。
MODEL_API_BASE=https://dashscope.aliyuncs.com/api/v1
MODEL_BYPASS_PROXY=true
